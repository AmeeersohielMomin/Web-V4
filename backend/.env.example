# Database connection string
# For MongoDB: mongodb://localhost:27017/your-database
# For PostgreSQL: postgresql://user:password@localhost:5432/your-database
DATABASE_URL=mongodb://localhost:27017/auth_app

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production
JWT_EXPIRES_IN=7d

# Bcrypt Configuration
BCRYPT_SALT_ROUNDS=10

# Server Configuration
PORT=5000

# Enabled Modules (comma-separated)
ENABLED_MODULES=auth
