# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:3000

# MongoDB
DATABASE_URL=mongodb://localhost:27017/idea_platform

# Platform JWT
JWT_SECRET=change-this-to-a-random-64-char-string
JWT_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=10

# AI Providers (configure whichever you use)
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_URL=http://localhost:11434

# Enabled modules
ENABLED_MODULES=auth,project,ai

# Stripe (billing)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_STARTER_PRICE_ID=
STRIPE_PRO_PRICE_ID=

# Monitoring
SENTRY_DSN=

# GitHub OAuth (optional for one-click GitHub connect)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5000/api/deploy/github/callback
